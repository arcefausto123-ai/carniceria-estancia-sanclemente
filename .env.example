# ── Base de datos (Supabase → Project Settings → Database) ──────────────
# Connection pooling (pgbouncer), es la que usa la app en runtime:
DATABASE_URL="postgresql://postgres.PROYECTO:CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa, la usa Prisma para migraciones:
DIRECT_URL="postgresql://postgres.PROYECTO:CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Sesión del panel administrativo ────────────────────────────────────
# Generala con: openssl rand -base64 32
AUTH_SECRET=""

# ── Usuario admin inicial (sólo lo lee el seed) ────────────────────────
ADMIN_EMAIL="admin@estanciasanclemente.com"
ADMIN_PASSWORD=""

# ── Supabase Storage (fotos de productos, categorías y logo) ───────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://PROYECTO.supabase.co"
# OJO: la service_role saltea todas las reglas de seguridad de Supabase.
# Va sólo como variable de entorno del servidor. Nunca en el repo, nunca en
# código que llegue al navegador.
SUPABASE_SERVICE_ROLE_KEY=""
# Sin estas dos, el panel sigue andando pero pidiendo la URL de la imagen
# a mano en vez de ofrecer subir un archivo.
